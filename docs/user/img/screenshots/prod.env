# Production data used by the screenshots (`make`), visible to the rtfd-qa user.
# Projects are always shown as "docs" (or "tutorial") in the images.
COMMUNITY_URL=https://app.readthedocs.org
BUSINESS_URL=https://app.readthedocs.com
# Any project, for forms
PROJECT=test-builds
# Project with redirects, analytics, and a successful build of a standard
# Sphinx project
BUSY_PROJECT=test-builds
BUILD_ID=34802219
# Project with an outgoing webhook
WEBHOOK_PROJECT=test-builds
WEBHOOK_ID=616
# These are on Business, but are shown as Community: log in to both.
# GitHub incoming webhook integration, with recent activity
INTEGRATION_SITE=https://app.readthedocs.com
INTEGRATION_PROJECT=read-the-docs-qa-test-builds-en
INTEGRATION_ID=2614
# Project with subprojects
SUBPROJECT_SITE=https://app.readthedocs.com
SUBPROJECT_PARENT=read-the-docs-qa-superproject
# Business: team highlighted in "Add project" (data-value, empty for the first),
# and a project with an SSH key
BUSINESS_TEAM=
